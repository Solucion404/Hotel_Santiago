---
import { Image } from "astro:assets";
import { HeroBackground } from "./HeroBackground";
import { HeroContent } from "./HeroContent";

// Importación de imagen para optimización nativa
import heroBg from "../../assets/images/hero-bg.jpg";
---

<section
    class="relative h-screen w-full flex flex-col items-center justify-center overflow-hidden bg-neutral-900 text-center scroll-mt-32"
    id="inicio"
>
    <!-- Imagen de fondo optimizada con animación de alejamiento -->
    <HeroBackground client:load>
        <Image
            src={heroBg}
            alt="Fondo Hotel Santiago"
            class="w-full h-full object-cover"
            quality="high"
            densities={[1.5, 2]}
            loading="eager"
        />
    </HeroBackground>

    <div class="absolute inset-0 bg-black/10 z-10"></div>

    <HeroContent client:load />
</section>
