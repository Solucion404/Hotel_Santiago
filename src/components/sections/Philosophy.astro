---
import { PhilosophyContent } from "./PhilosophyContent";
import recepcionImg from "../../assets/images/recepcion.jpg";
import secondaryImg from "../../assets/images/philosophy-secondary.jpg";

const content = {
    title: "Nuestra Filosofía",
    subtitle: "Más que un hotel, una herencia viva.",
    description:
        "En el corazón de Yajalón, Hotel Santiago se erige como un santuario donde tu comodidad abraza las raíces chiapanecas. Cada detalle cuenta la historia de nuestra tierra verde, honrando la tradición con un toque de lujo contemporáneo.",
    items: [
        {
            icon: "☕",
            label: "Café Local",
            text: "Nuestro propio café Santiago a la altura de tus expectativas.",
        },
        {
            icon: "🏙️",
            label: "Arquitectura",
            text: "Moderna y urbana conviviendo con la esencia local.",
        },
        {
            icon: "✨",
            label: "Hospitalidad",
            text: "Servicio de calidad con alma y calidez chiapaneca.",
        },
        {
            icon: "🌿",
            label: "Naturaleza",
            text: "Rodeado de la selva verde y el aire puro de Yajalón.",
        },
    ],
};

const images = {
    main: recepcionImg.src,
    secondary: secondaryImg.src,
};
---

<section
    class="py-24 lg:py-32 px-6 relative overflow-hidden scroll-mt-32 shadow-[inset_0_30px_30px_-15px_rgba(0,0,0,0.8)]"
    id="esencia"
>
    <!-- Sin overlay extra -->

    <div class="max-w-7xl mx-auto relative z-10">
        <PhilosophyContent
            client:visible
            title={content.title}
            subtitle={content.subtitle}
            description={content.description}
            mainImage={images.main}
            secondaryImage={images.secondary}
            items={content.items}
        />
    </div>
</section>
