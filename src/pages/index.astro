---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Philosophy from "../components/sections/Philosophy.astro";
import Rooms from "../components/sections/Rooms.astro";
import Gallery from "../components/sections/Gallery.astro";
import { Contact } from "../components/sections/Contact";
import Map from "../components/ui/Map.astro";
import Footer from "../components/layout/Footer.astro";
import { getImage } from "astro:assets";
import philosophyBg from "../assets/images/philosophy-bg.jpg";

const optimizedBg = await getImage({ src: philosophyBg, format: "webp" });
---

<Layout title="Inicio">
	<Header />
	<!-- Cimiento de Parallax Global Bulletproof -->
	<div
		class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat pointer-events-none"
		style={`background-image: url('${optimizedBg.src}');`}
	>
	</div>

	<main class="relative z-0">
		<Hero />
		<Philosophy />
		<Rooms />
		<Gallery />
		<Contact client:visible />
		<section class="pb-24 px-6 bg-bone">
			<div
				class="max-w-7xl mx-auto h-[450px] rounded-3xl overflow-hidden shadow-2xl border-8 border-white"
			>
				<Map />
			</div>
		</section>
	</main>
	<Footer />
</Layout>
